<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">

<Properties>         
       <Property name="basePath">./Logs</Property>  <!--stored file in "Logs" folder. file name should be anything-->
</Properties>        <!--customized based on project-->
  
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
    </Console>
               
    <RollingFile name="File" filename="${basePath}/automation.log" filePattern="${basePath}/automation-%d{yyyy-MM-dd}.log">
       <PatternLayout pattern="%d{HH:mm:ss.SSS} [%t] %-5level %logger{36} - %msg%n"/>
       <SizeBasedTriggeringPolicy size="5000"/>
    </RollingFile>   <!--customized based on project-->  
  </Appenders>
  
  <Loggers>
    <Root level="Debug"> <!--here you can use multiple log levels All>Trace>Debug>Info>Warn>Error>Fatal>Off-->
     <!-- <AppenderRef ref="Console"/>--> 
      <AppenderRef ref="File"/>
    </Root>
  </Loggers>
</Configuration>
